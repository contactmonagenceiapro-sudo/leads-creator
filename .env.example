# Copiez ce fichier vers .env puis renseignez vos propres valeurs.
# Ne JAMAIS committer le fichier .env réel (voir .gitignore).

# === BASE DE DONNÉES (usage interne docker-compose / postgres) ===
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=postgres
DB_PORT=5432

# === SUPABASE ===
# SUPABASE_KEY doit être la clé "service_role" (accès total) : elle ne doit
# JAMAIS être exposée côté client/navigateur, uniquement côté serveur (api/).
SUPABASE_URL=
SUPABASE_KEY=

# === REDIS (optionnel, non utilisé par le pipeline actuel) ===
REDIS_HOST=redis
REDIS_PORT=6379

# === OLLAMA ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_FAST=qwen2.5:3b
OLLAMA_MODEL_MAIN=qwen2.5:7b
OLLAMA_MODEL_REASON=deepseek-r1:7b
OLLAMA_MODEL_EMBED=nomic-embed-text
OLLAMA_TIMEOUT=90

# === API INTERNE (api/main.py) ===
# Clé partagée exigée dans le header X-API-Key pour tous les endpoints
# mutants/sensibles. Générez une valeur forte, par ex : openssl rand -hex 32
# Réutilisée telle quelle par dashboard/api_client.py.
API_SECRET_KEY=
API_URL=http://127.0.0.1:8000
# URL PUBLIQUEMENT accessible depuis Internet (jamais localhost/un alias
# docker interne) — utilisée dans les liens envoyés par e-mail (présentation,
# formulaire d'intake, pixel/liens de suivi d'ouverture-clic). En production
# avec un domaine fixe (voir section "DOMAINE DE PRODUCTION" ci-dessous),
# renseignez ici https://<API_DOMAIN> (ex: https://api.mondomaine.com).
# UNIQUEMENT en repli si aucun agent ngrok actif n'est trouvé via
# NGROK_API_URL (voir ngrok_url.py) : utile seulement en dev local avec un
# tunnel ngrok, ignoré en production. Sans domaine public en HTTPS ni ngrok
# actif, ces liens/le pixel ne fonctionneront pas depuis la messagerie du
# destinataire. Laisser vide = repli sur API_URL.
PUBLIC_APP_URL=
# API locale de l'agent ngrok (http://127.0.0.1:4040/api/tunnels par défaut,
# tant qu'un tunnel ngrok tourne) — permet de récupérer l'URL https ACTIVE au
# moment de l'envoi, utile UNIQUEMENT en dev local avec un tunnel ngrok.
# Laisser vide en production (aucun agent ngrok qui tourne : repli
# automatique et silencieux sur PUBLIC_APP_URL, voir ngrok_url.py).
NGROK_API_URL=

# === DOMAINE DE PRODUCTION (Caddy — voir Caddyfile / docker-compose.yml) ===
# Sous-domaines dédiés à chaque service, en DNS de type A pointant vers l'IP
# du serveur de production (voir DEPLOIEMENT.md). Caddy obtient et renouvelle
# automatiquement un certificat Let's Encrypt pour chacun. Laisser vides tant
# qu'aucun domaine n'est encore configuré (le service caddy ne démarrera pas
# correctement sans eux — non utilisé en dev local).
API_DOMAIN=
DASHBOARD_DOMAIN=
N8N_DOMAIN=
# E-mail utilisé par Let's Encrypt (expiration de certificat, changements de
# CA) — pas envoyé au client final, uniquement à Let's Encrypt.
CADDY_ACME_EMAIL=

# Score (0 à 1, table campagnes/leads_professionnels.score_final) à partir
# duquel un nouveau lead déclenche une alerte temps réel (Discord + e-mail
# CEO_EMAIL) — voir outbound_chantiers/scorer_et_publier.py et api/main.py.
SEUIL_LEAD_ULTRA_QUALIFIE=0.85

# === AUTOMATISATION (cron interne à l'API, APScheduler) ===
# Source UNIQUE de planification du pipeline (le crontab hôte a été retiré
# pour éviter les doubles déclenchements — cf. sql/init.sql et api/main.py).
CRON_LEADS_INTERVAL_HOURS=1
CRON_MAIL_INTERVAL_MINUTES=5
CRON_CEO_AGENT_HOUR=20

# === RELANCE DES PROSPECTS SANS RÉPONSE (relance_prospects.py) ===
DELAI_PREMIERE_RELANCE_JOURS=4
DELAI_RELANCE_SUIVANTE_JOURS=4
MAX_RELANCES=2

# === SCRAPER (optionnel) ===
# Liste de proxies HTTP séparés par des virgules, ex: http://ip1:port,http://ip2:port
# Laisser vide = pas de proxy (utilise l'IP locale).
PROXIES=

# === ENRICHISSEMENT TÉLÉPHONE — Google Places (optionnel, payant) ===
# Dernier recours si le site propre de l'entreprise ne publie aucun
# téléphone (voir phone_enricher.py) — laisser vide = brique désactivée,
# le reste du pipeline continue normalement sans elle.
# Clé obtenue sur https://console.cloud.google.com/ (activer "Places API" +
# facturation) — ~0,02-0,03 €/recherche (Find Place + Place Details).
GOOGLE_PLACES_API_KEY=

# === N8N ===
N8N_USER=admin
N8N_PASSWORD=
N8N_ENCRYPTION_KEY=

# === ZOHO (envoi/lecture d'emails) ===
ZOHO_USER=
ZOHO_PASSWORD=
# Optionnel : nom d'un dossier IMAP existant (ex: "Archive" ou "INBOX/Bounces")
# vers lequel déplacer les bounces déjà traités par mail_processor.py, en plus
# de les marquer comme lus. Laisser vide pour juste les marquer lus sans les
# déplacer (comportement par défaut).
ZOHO_DOSSIER_BOUNCES_TRAITES=

# === DISCORD (alertes lead chaud, mail_processor.py) ===
DISCORD_WEBHOOK_URL=

# === AGENCE ===
AGENCY_NAME=Expertise Digitale
AGENCY_EMAIL=
CEO_EMAIL=

# === YOUSIGN (signature électronique du devis/contrat, déclenchée après l'intake) ===
YOUSIGN_API_KEY=
YOUSIGN_API_URL=https://api-sandbox.yousign.app/v3
# Secret utilisé pour vérifier la signature HMAC des webhooks Yousign (header
# X-Yousign-Signature-256). Sans ce secret, l'endpoint /webhooks/yousign refuse
# tous les événements (401).
YOUSIGN_WEBHOOK_SECRET=

# === STRIPE (lien de paiement envoyé dès le contrat signé) ===
# Clé secrète (Dashboard Stripe > Développeurs > Clés API > "Secret key").
# En mode test, commence par sk_test_ ; en production par sk_live_.
STRIPE_SECRET_KEY=
# Optionnelle, non utilisée côté serveur (utile seulement pour un futur
# frontend Stripe.js/Elements) : conservée si déjà présente dans .env.
STRIPE_PUBLIC_KEY=
# Secret utilisé pour vérifier la signature du webhook Stripe (header
# stripe-signature). Sans ce secret, l'endpoint /webhooks/stripe refuse
# tous les événements (401).
STRIPE_WEBHOOK_SECRET=
# Montant du contrat en euros TTC, utilisé pour le devis PDF et le lien Stripe.
CONTRACT_AMOUNT_EUR=990
