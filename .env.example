# Copiez ce fichier vers .env puis renseignez vos propres valeurs.
# Ne JAMAIS committer le fichier .env réel (voir .gitignore).

# === BASE DE DONNÉES (usage interne docker-compose / postgres) ===
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=postgres
DB_PORT=5432

# === SUPABASE ===
# SUPABASE_KEY doit être la clé "service_role" (accès total) : elle ne doit
# JAMAIS être exposée à un navigateur. Le dashboard Streamlit l'utilise
# directement (voir dashboard/supabase_client.py) — cette clé reste
# server-side (le code Python d'une app Streamlit ne s'exécute jamais dans
# le navigateur du visiteur, même pour les pages publiques).
SUPABASE_URL=
SUPABASE_KEY=

# === REDIS (optionnel, non utilisé par le pipeline actuel) ===
REDIS_HOST=redis
REDIS_PORT=6379

# === OLLAMA (dev local / docker-compose) ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_FAST=qwen2.5:3b
OLLAMA_MODEL_MAIN=qwen2.5:7b
OLLAMA_MODEL_REASON=deepseek-r1:7b
OLLAMA_MODEL_EMBED=nomic-embed-text
OLLAMA_TIMEOUT=90

# === LLM — bascule cloud pour la génération de pitch en production ===
# Voir llm_config.py (racine) : URL utilisée par lead_worker.py et
# outbound_chantiers/outbound_pro_btp.py pour générer les pitchs de
# prospection, par ordre de priorité LLM_API_URL > OLLAMA_HOST > défaut
# localhost. À renseigner dès que l'app tourne sans accès à un Ollama local
# (ex: Streamlit Cloud) : URL d'un Ollama hébergé publiquement (Render...)
# ou de toute API exposant POST {url}/api/generate. Si vide et OLLAMA_HOST
# injoignable, la génération échoue proprement et repli sur un pitch
# générique (jamais de blocage de la boucle d'envoi) — mais sans
# personnalisation IA.
LLM_API_URL=
# Jeton "Authorization: Bearer" envoyé si LLM_API_URL est protégé (recommandé
# dès que l'endpoint est exposé publiquement).
LLM_API_KEY=

# === DASHBOARD (Streamlit) ===
# URL publique de l'app Streamlit (ex: https://mon-app.streamlit.app),
# utilisée dans les liens envoyés par e-mail (présentation, formulaire
# d'intake — voir mail_processor.py::envoyer_suivi_positif et
# dashboard/pages_publiques.py). Sans elle, ces liens pointent vers
# localhost et ne fonctionnent pas depuis la messagerie du destinataire.
PUBLIC_DASHBOARD_URL=http://localhost:8501

# Score (0 à 1, table campagnes/leads_professionnels.score_final) à partir
# duquel un nouveau lead déclenche une alerte temps réel (Discord + e-mail
# CEO_EMAIL) — voir outbound_chantiers/scorer_et_publier.py.
SEUIL_LEAD_ULTRA_QUALIFIE=0.85

# === RELANCE DES PROSPECTS SANS RÉPONSE (relance_prospects.py) ===
DELAI_PREMIERE_RELANCE_JOURS=4
DELAI_RELANCE_SUIVANTE_JOURS=4
MAX_RELANCES=2

# === SCRAPER (optionnel) ===
# Liste de proxies HTTP séparés par des virgules, ex: http://ip1:port,http://ip2:port
# Laisser vide = pas de proxy (utilise l'IP locale).
PROXIES=

# === ENRICHISSEMENT TÉLÉPHONE — Google Places (optionnel, payant) ===
# Dernier recours si le site propre de l'entreprise ne publie aucun
# téléphone (voir phone_enricher.py) — laisser vide = brique désactivée,
# le reste du pipeline continue normalement sans elle.
# Clé obtenue sur https://console.cloud.google.com/ (activer "Places API" +
# facturation) — ~0,02-0,03 €/recherche (Find Place + Place Details).
GOOGLE_PLACES_API_KEY=

# === N8N ===
N8N_USER=admin
N8N_PASSWORD=
N8N_ENCRYPTION_KEY=

# === ZOHO (envoi/lecture d'emails) ===
ZOHO_USER=
ZOHO_PASSWORD=
# Optionnel : nom d'un dossier IMAP existant (ex: "Archive" ou "INBOX/Bounces")
# vers lequel déplacer les bounces déjà traités par mail_processor.py, en plus
# de les marquer comme lus. Laisser vide pour juste les marquer lus sans les
# déplacer (comportement par défaut).
ZOHO_DOSSIER_BOUNCES_TRAITES=

# === DISCORD (alertes lead chaud, mail_processor.py) ===
DISCORD_WEBHOOK_URL=

# === AGENCE ===
AGENCY_NAME=Expertise Digitale
AGENCY_EMAIL=
CEO_EMAIL=

# === YOUSIGN (signature électronique du devis/contrat, déclenchée après l'intake) ===
# Pas de webhook (supprimé avec le backend FastAPI) : la confirmation de
# signature est VÉRIFIÉE MANUELLEMENT par l'admin dans Yousign, puis
# confirmée dans le dashboard (bouton "Marquer signé", voir
# dashboard/app_pages/gestion_clients.py) — YOUSIGN_WEBHOOK_SECRET n'est
# donc plus nécessaire.
YOUSIGN_API_KEY=
YOUSIGN_API_URL=https://api-sandbox.yousign.app/v3

# === STRIPE (lien de paiement envoyé dès le contrat signé) ===
# Clé secrète (Dashboard Stripe > Développeurs > Clés API > "Secret key").
# En mode test, commence par sk_test_ ; en production par sk_live_.
STRIPE_SECRET_KEY=
# Optionnelle, non utilisée côté serveur (utile seulement pour un futur
# frontend Stripe.js/Elements) : conservée si déjà présente dans .env.
STRIPE_PUBLIC_KEY=
# Pas de webhook (supprimé avec le backend FastAPI) : la confirmation de
# paiement est VÉRIFIÉE MANUELLEMENT par l'admin dans Stripe, puis confirmée
# dans le dashboard (bouton "Marquer payé", avec saisie du payment_intent_id
# affiché dans Stripe) — STRIPE_WEBHOOK_SECRET n'est donc plus nécessaire.
# Montant du contrat en euros TTC, utilisé pour le devis PDF et le lien Stripe.
CONTRACT_AMOUNT_EUR=990
