# Reverse proxy HTTPS pour le déploiement en production — remplace ngrok par
# un domaine fixe. Caddy obtient et renouvelle automatiquement les
# certificats Let's Encrypt pour chaque sous-domaine ci-dessous, tant que
# leurs enregistrements DNS (A) pointent bien vers l'IP de ce serveur et que
# les ports 80/443 sont ouverts (voir DEPLOIEMENT.md).
#
# {$API_DOMAIN}, {$DASHBOARD_DOMAIN}, {$N8N_DOMAIN} sont substitués à partir
# des variables d'environnement du même nom (voir .env — section "DOMAINE DE
# PRODUCTION"), injectées au conteneur caddy via env_file dans
# docker-compose.yml.
#
# Les noms "api", "dashboard", "n8n" ci-dessous sont les alias réseau Docker
# des services correspondants (docker-compose.yml) — Caddy les joint
# directement via le réseau interne, jamais via un port publié sur l'hôte.

{
	# E-mail de contact ACME (Let's Encrypt) : notifications d'expiration
	# uniquement, jamais transmis au client final.
	email {$CADDY_ACME_EMAIL}
}

{$API_DOMAIN} {
	reverse_proxy api:8000
}

{$DASHBOARD_DOMAIN} {
	# Dashboard Streamlit : nécessite un WebSocket persistant (rechargements
	# réactifs de l'UI). Caddy transmet Upgrade/Connection automatiquement
	# via reverse_proxy, aucune directive supplémentaire n'est nécessaire.
	reverse_proxy dashboard:8501
}

{$N8N_DOMAIN} {
	reverse_proxy n8n:5678
}
